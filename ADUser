#To review users that have signed in since $cutOffDay in the last 30 days, enter the following command
Get-ADUser -Properties LastLogonDate -Filter {LastLogonDate -gt $cutOffDate} | Export-Csv -Path c:\lastlogon.csv -NoTypeInformation

#Command to get list of Active Directory users that will expire in next 30 days in a specific OU (change OU b/w the <>)
Search-ADAccount -AccountExpiring -SearchBase "<DC=Adatum,DC=com>" -UsersOnly -TimeSpan 30.00:00:00 | select-object UserPrincipalName,Enabled,AccountExpirationDate,LastLogonDate,DistinguishedName | Export-Csv -Path c:\expiringaccounts.csv -NoTypeInformation

#Pull AD Users of a specific department and city
Get-ADUser -Filter * -Properties Department,City | Where {$PSItem.Department -eq ‘IT’ -and $PSItem.City -eq ‘London’} | Select-Object -Property Name,Department,City| Sort Name


#Pull AD Users and export to HTML or CSV or XML
Get-ADUser -Filter * -Properties Department,City,Office | 
Where {$PSItem.Department -eq 'IT' -and $PSItem.City -eq 'London'} | 
Sort Name | 
Select-Object -Property Name,Department,City,Office |
ConvertTo-Html –Property Name,Department,City -PreContent Users | 

